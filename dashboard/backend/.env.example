# Redshift connection for the dashboard backend. Never commit this file.
REDSHIFT_HOST=your-cluster.region.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dwh
REDSHIFT_USER=your_user
REDSHIFT_PASSWORD=change-me

# Propone tenant shown on the dashboard (1 = Zameen Development)
PROPONE_TENANT_ID=1

# users.id where the visible staff hierarchy starts (3 = Arman Yousaf)
HIERARCHY_ROOT_USER_ID=3

# Seconds between background refreshes of the Redshift snapshot
REFRESH_SECONDS=60
DB_POOL_SIZE=3   # this login allows only ~5 Redshift sessions in total; 2 are used by the refresh, 1 by page requests

# Allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login for the dashboard when shared through a tunnel (leave empty for local-only use)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DB_TIMEOUT_SECONDS=120
